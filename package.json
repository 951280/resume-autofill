{
  "name": "resume-autofill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome 扩展：识别招聘网站表单字段并用本地简历一键回填",
  "scripts": {
    "build": "vite build --config vite.content.config.ts && vite build --config vite.main.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "icons": "python tools/gen_icons.py",
    "demo": "python -m http.server 8000 --directory demo"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
